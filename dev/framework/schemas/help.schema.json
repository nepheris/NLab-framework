  "Data": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "SCH_HELP_REGISTRY",
    "title": "nLab contextual help registry",
    "type": "object",
    "required": ["metadata", "Data", "dictionnaire_donnees"],
    "properties": {
      "metadata": {"type": "object"},
      "Data": {
        "type": "object",
        "required": ["purpose", "defaults", "entries", "resolution", "rules"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1},
          "defaults": {
            "type": "object",
            "required": ["public_panel_mode", "long_text_initial_state", "dev_overlay", "tooltip_source"],
            "properties": {
              "public_panel_mode": {"enum": ["short_only", "long_only", "short_then_long"]},
              "long_text_initial_state": {"enum": ["collapsed", "expanded"]},
              "dev_overlay": {"enum": ["hidden", "below_public", "separate_tab"]},
              "dev_section_initial_state": {"enum": ["collapsed", "expanded"]},
              "tooltip_source": {"type": "string"},
              "global_help_id": {"type": "string", "minLength": 1},
              "panel_title": {"type": "string", "minLength": 1},
              "long_text_label": {"type": "string", "minLength": 1},
              "dev_overlay_label": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["help_id", "public"],
              "properties": {
                "help_id": {"type": "string", "minLength": 1},
                "public": {
                  "type": "object",
                  "required": ["short_text", "long_text"],
                  "properties": {
                    "short_text": {"type": "string", "minLength": 1},
                    "long_text": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "display": {
                  "type": "object",
                  "properties": {
                    "panel_mode": {"enum": ["short_only", "long_only", "short_then_long"]},
                    "long_text_initial_state": {"enum": ["collapsed", "expanded"]}
                  },
                  "additionalProperties": false
                },
                "dev_notes": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "resolution": {
            "type": "object",
            "required": ["public", "dev"],
            "properties": {
              "public": {"type": "array", "items": {"type": "string"}},
              "dev": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "rules": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "dictionnaire_donnees": {"type": "object"}
    },
    "additionalProperties": false
  },
  "dictionnaire_donnees": {
