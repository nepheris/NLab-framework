{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlab.dev/schemas/site-generation-checklist.schema.json",
  "title": "nLab Site Generation Checklist",
  "description": "Declarative, non-executable checklist for a generic site generation pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "name", "stages"],
  "properties": {
    "schema": { "const": "nlab.site-generation-checklist" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "mode",
        "required",
        "depends_on",
        "inputs",
        "outputs",
        "success_criteria",
        "on_failure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "preflight",
            "data-load",
            "validation",
            "relations",
            "render",
            "assets",
            "routes",
            "output",
            "preview",
            "comparison",
            "report"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["machine", "human", "hybrid"] },
        "required": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "uniqueItems": true
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "on_failure": { "enum": ["stop", "warn", "continue"] },
        "notes": { "type": "string" }
      }
    },
    "artifact": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  }
}
