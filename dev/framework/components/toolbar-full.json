{
  "metadata":{"id":"COMP_TOOLBAR_FULL","json_type":"framework_component_config","scope":"framework","schema_id":null,"version":"1.1.1","status":"stable","date_creation":"2026-08-09","date_mise_a_jour":"2026-08-09"},
  "Data":{
